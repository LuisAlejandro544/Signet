---
---

<section id="download" class="py-20 bg-oled-900/40 border-t border-gray-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-400 text-xs font-mono font-bold mb-4">
        Distribución Universal & Libre
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Descarga Signet para Android
      </h2>
      <p class="mt-4 text-gray-400 text-sm sm:text-base">
        Compatible con Android 8.0+ (API 26) hasta Android 15/16. Funciona sin dependencias de Google Play Services en cualquier teléfono, tablet o ROM personalizada.
      </p>

      <!-- Download Buttons Grid -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto">
        
        <!-- Direct APK Download -->
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl bg-brand-500 hover:bg-brand-400 text-gray-950 flex flex-col items-center justify-center gap-2 transition-all hover:scale-105 shadow-lg shadow-brand-500/20 group"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <div class="font-bold text-sm">Descarga Directa APK</div>
          <div class="text-[11px] font-mono text-gray-900/80">app-debug.apk</div>
        </a>

        <!-- GitHub Releases -->
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl bg-oled-900 hover:bg-oled-800 border border-gray-800 text-white flex flex-col items-center justify-center gap-2 transition-all hover:scale-105 group"
        >
          <svg class="w-7 h-7 text-brand-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <div class="font-bold text-sm">GitHub Releases</div>
          <div class="text-[11px] font-mono text-gray-400">Código & Tags</div>
        </a>

        <!-- Uptodown / F-Droid -->
        <a
          href="https://uptodown.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl bg-oled-900 hover:bg-oled-800 border border-gray-800 text-white flex flex-col items-center justify-center gap-2 transition-all hover:scale-105 group"
        >
          <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          <div class="font-bold text-sm">Uptodown App Store</div>
          <div class="text-[11px] font-mono text-gray-400">Actualizaciones</div>
        </a>

      </div>

      <div class="mt-8 text-xs text-gray-500 font-mono">
        MD5 / SHA-256 Checksums verificables en cada versión publicada.
      </div>
    </div>

  </div>
</section>
