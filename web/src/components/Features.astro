---
const features = [
  {
    title: "Criptografía X.509 de Alto Nivel",
    description: "Genera certificados con algoritmos RSA (2048 y 4096 bits) y Curvas Elípticas (EC P-256) con firmas SHA-256 usando BouncyCastle.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
    tag: "PKCS#12 / JKS"
  },
  {
    title: "Generador CSPRNG con Medidor de Entropía",
    description: "Generación de contraseñas de alta seguridad con SecureRandom, longitud configurable (16 a 32 caracteres) y símbolos seguros para Gradle.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>`,
    tag: "CSPRNG Nativo"
  },
  {
    title: "Base64 & Snippets Listos para CI/CD",
    description: "Exporta la clave en Base64 para variables de entorno de GitHub Actions, Bitrise o Fastlane, junto con snippets para Kotlin DSL y Groovy.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
    tag: "GitHub Actions"
  },
  {
    title: "Respaldos ZIP con Firma Anti-Manipulación",
    description: "Exporta paquetes .zip completos con manifiesto firmado por HMAC-SHA256 y hash SHA-256. Rechaza automáticamente archivos manipulados.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>`,
    tag: "HMAC-SHA256"
  },
  {
    title: "Extracción Instantánea de Huellas",
    description: "Inspecciona cualquier archivo .jks, .keystore o .p12 y extrae huellas SHA-256, SHA-1 y MD5 requeridas por Firebase y Google Sign-In.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>`,
    tag: "Firebase / Auth"
  },
  {
    title: "Modo Negro 100% AMOLED & Material You",
    description: "Interfaz Jetpack Compose de máxima fluidez con color dinámico Android 12+ y modo negro puro (#000000) para pantallas OLED.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>`,
    tag: "Material 3"
  }
];
---

<section id="features" class="py-20 bg-oled-900/30 border-y border-gray-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase font-mono font-bold text-brand-400 tracking-wider">Capacidades del Sistema</h2>
      <p class="mt-3 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Todo lo que necesitas para firmar apps Android sin tocar la terminal
      </p>
      <p class="mt-4 text-gray-400 text-sm sm:text-base">
        Diseñado tanto para desarrolladores independientes como para ingenieros DevOps que necesitan agilidad sin sacrificar seguridad criptográfica.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="p-6 rounded-2xl bg-oled-900/80 border border-gray-800/80 glow-card flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feature.icon} />
              </div>
              <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded bg-gray-800 text-gray-300 border border-gray-700">
                {feature.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-400 leading-relaxed">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
