---
---

<section class="relative pt-20 pb-16 md:pt-32 md:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Security Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-mono font-semibold mb-8 animate-fade-in">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
      </svg>
      100% Offline • Cero Telemetría • Criptografía BouncyCastle
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
      Genera y administra tus <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-emerald-300 to-teal-400">Android Keystores</span> en tu móvil
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed font-normal">
      Crea claves de firma <code class="text-brand-300 font-mono bg-oled-900 px-1.5 py-0.5 rounded border border-gray-800">.jks</code> y <code class="text-brand-300 font-mono bg-oled-900 px-1.5 py-0.5 rounded border border-gray-800">.keystore</code>, exporta a Base64 para CI/CD, extrae huellas SHA-256 para Firebase y respalda con firmas anti-manipulación. Sin telemetría.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#download"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-gray-950 font-bold text-sm shadow-xl shadow-brand-500/25 transition-all hover:scale-105"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Descargar APK Gratis
      </a>

      <a
        href="/privacy"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-gray-700 bg-oled-900/80 hover:bg-oled-800 text-gray-200 text-sm font-semibold transition-all hover:border-gray-600"
      >
        <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Ver Política de Cero Recolección
      </a>
    </div>

    <!-- Metrics / Guarantees Ribbon -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-gray-800/80 text-left">
      <div class="p-4 rounded-xl bg-oled-900/40 border border-gray-800/60">
        <div class="text-brand-400 font-mono text-2xl font-bold">0 B</div>
        <div class="text-xs text-gray-400 mt-1">Datos enviados a la red</div>
      </div>
      <div class="p-4 rounded-xl bg-oled-900/40 border border-gray-800/60">
        <div class="text-brand-400 font-mono text-2xl font-bold">CSPRNG</div>
        <div class="text-xs text-gray-400 mt-1">Entropía criptográfica real</div>
      </div>
      <div class="p-4 rounded-xl bg-oled-900/40 border border-gray-800/60">
        <div class="text-brand-400 font-mono text-2xl font-bold">HMAC</div>
        <div class="text-xs text-gray-400 mt-1">Respaldos anti-tamper</div>
      </div>
      <div class="p-4 rounded-xl bg-oled-900/40 border border-gray-800/60">
        <div class="text-brand-400 font-mono text-2xl font-bold">GPL v3</div>
        <div class="text-xs text-gray-400 mt-1">100% Código Abierto</div>
      </div>
    </div>

  </div>
</section>
